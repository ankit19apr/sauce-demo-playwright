    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
