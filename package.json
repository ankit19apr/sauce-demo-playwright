{
  "name": "sauce-demo-playwright",
  "version": "1.0.0",
  "description": "Playwright UI automation for SauceDemo",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:clean": "node -e \"const fs=require('node:fs'); for (const p of ['allure-results','allure-report']) fs.rmSync(p,{recursive:true,force:true})\""
  },
  "keywords": [
    "playwright",
    "automation",
    "saucedemo",
    "allure-report"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
}
